{
	"name": "gioxx/gistful",
	"description": "Gistful for GitHub - embed GitHub Gists in WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2",
		"wp-phpunit/wp-phpunit": "*",
		"johnpbloch/wordpress-core": "*",
		"wpackagist-plugin/sqlite-database-integration": "*",
		"wp-cli/wp-cli-bundle": "*",
		"wp-coding-standards/wpcs": "^3",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*"
			]
		}
	],
	"extra": {
		"installer-paths": {
			"vendor/wordpress/plugins/{$name}/": [
				"type:wordpress-plugin"
			]
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "@php bin/run-tests.php",
		"serve": "bin/dev-site.sh"
	},
	"scripts-descriptions": {
		"lint": "Run PHPCS.",
		"test": "Run the PHPUnit suite on the SQLite harness.",
		"serve": "Start the local dev site (php -S + SQLite)."
	}
}
